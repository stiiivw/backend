    {"id": 4, "name": "Ботокс", "category_id": 1},
    {"id": 5, "name": "Уход", "category_id": 1},
    {"id": 6, "name": "Маникюр", "category_id": 2},
    {"id": 7, "name": "Педикюр", "category_id": 2},
