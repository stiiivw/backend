# --- Задание 1: список категорий с количеством услуг ---
@app.get("/categories")
def get_categories():
    result = []
    for category in categories:
        services_count = sum(
            1 for service in services if service["category_id"] == category["id"]
        )
        result.append({
            "id": category["id"],
            "name": category["name"],
            "servicesCount": services_count,
        })
    return result


# --- Задание 2: информация по конкретной категории ---
@app.get("/categories/{category_id}")
def get_category(category_id: int):
    category = next(
        (c for c in categories if c["id"] == category_id),
        None,
    )
    if category is None:
        raise HTTPException(status_code=404, detail="Category not found")

    services_count = sum(
        1 for service in services if service["category_id"] == category_id
    )
    return {
        "id": category["id"],
        "name": category["name"],
        "servicesCount": services_count,
    }